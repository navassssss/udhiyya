# -----------------------------------------------------------------------------
# QurbaniOS Frontend Configuration
# -----------------------------------------------------------------------------

# Backend API endpoint (NestJS + Fastify)
# Include the backend's global API prefix.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# API Mode:
# - 'false': Attempts live requests to VITE_API_BASE_URL with graceful fallback to mocks if backend is unreachable
# - 'true': Forces pure in-memory mock client for all unintegrated or test endpoints
VITE_USE_MOCK_API=false

# -----------------------------------------------------------------------------
# Authentication Provider Selection
# -----------------------------------------------------------------------------
# - 'nestjs' (current): Uses NestJS JWT access/refresh session tokens
# - 'supabase' (legacy starter option): Uses Supabase Auth tokens for Bearer auth
VITE_AUTH_PROVIDER=nestjs

# Google Identity Services Client ID (for Google Sign-In)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# -----------------------------------------------------------------------------
# Supabase Authentication
# -----------------------------------------------------------------------------
# Obtain from your Supabase Project Settings -> API (or local `npx supabase start`)
# If left blank or containing placeholder values, frontend automatically operates
# in Demo Simulation mode with 1-click role switcher on the /login page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# -----------------------------------------------------------------------------
# User Roles Configuration for Supabase Auth
# -----------------------------------------------------------------------------
# When creating users in Supabase Auth Studio or via API, attach the role in `user_metadata`:
# 1. Super Admin:       { "role": "super_admin", "name": "Platform Owner" }
# 2. Committee Admin:   { "role": "committee_admin", "name": "Mahallu Admin", "org_id": "org_demo" }
# 3. Volunteer:         { "role": "volunteer", "name": "Yusuf Ahmed", "org_id": "org_demo" }
# 4. Participant:       { "role": "participant", "name": "Mohammed Ashraf", "org_id": "org_demo" }

# -----------------------------------------------------------------------------
# M3 Enhancement Feature Flags
# -----------------------------------------------------------------------------
# EF-01: Analytics Dashboard (Committee Dashboard charts & telemetry)
VITE_FEATURE_EF_01=true

# EF-02: Smart Allocation Engine (Auto-pairing 7 shares per cattle)
VITE_FEATURE_EF_02=false

# Optional EFs (off by default)
VITE_FEATURE_EF_03=false
VITE_FEATURE_EF_04=false
VITE_FEATURE_EF_05=false
