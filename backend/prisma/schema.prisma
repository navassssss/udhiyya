generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  DELETED
}

enum AuthProvider {
  GOOGLE
}

enum RoleScope {
  GLOBAL
  ORGANIZATION
}

enum PermissionScope {
  GLOBAL
  ORGANIZATION
  BOTH
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ONBOARDING
  CLOSED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  REVOKED
  EXPIRED
}

model User {
  id                      String     @id @default(uuid()) @db.Uuid
  email                   String     @unique
  name                    String
  supabaseIdentity        String?    @unique @map("supabase_identity")
  passwordHash            String?    @map("password_hash")
  firstName               String?    @map("first_name")
  lastName                String?    @map("last_name")
  emailVerificationExempt Boolean    @default(false) @map("email_verification_exempt")
  avatarUrl               String?    @map("avatar_url")
  status                  UserStatus @default(ACTIVE)
  emailVerifiedAt         DateTime?  @map("email_verified_at")
  lastLoginAt             DateTime?  @map("last_login_at")
  activeOrganizationId    String?    @map("active_organization_id") @db.Uuid
  tokenVersion            Int        @default(1) @map("token_version")
  deletedAt               DateTime?  @map("deleted_at")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")

  activeOrganization      Organization?            @relation("UserActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  providerAccounts        AuthProviderAccount[]
  userRoles               UserRole[]               @relation("UserRoleTarget")
  assignedUserRoles       UserRole[]               @relation("UserRoleAssigner")
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMember[]
  assignedOrgMemberRoles  OrganizationMemberRole[] @relation("OrgMemberRoleAssigner")
  sentInvitations         OrganizationInvitation[] @relation("OrganizationInviter")
  sessions                Session[]
  refreshTokenHistory     RefreshTokenHistory[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]               @relation("AuditActor")

  applicantHouseholds ApplicantHousehold[]
  registrations       Registration[]

  volunteerAssignments Volunteer[]

  beneficiaryLinks Beneficiary[]

  programmeNotifications UserNotification[]
  programmeEmailJobs     NotificationEmail[]

  emailChangeTokens EmailChangeToken[]

  @@index([status])
  @@index([deletedAt])
  @@index([activeOrganizationId])
  @@map("users")
}

model AuthProviderAccount {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  providerEmail  String?      @map("provider_email")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("auth_provider_accounts")
}

model Role {
  id             String    @id @default(uuid()) @db.Uuid
  name           String
  slug           String
  description    String?
  scope          RoleScope @default(GLOBAL)
  isSystem       Boolean   @default(false) @map("is_system")
  organizationId String?   @map("organization_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization    Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]
  orgMemberRoles  OrganizationMemberRole[]
  invitations     OrganizationInvitation[]

  @@unique([scope, slug, organizationId])
  @@index([scope])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String          @id @default(uuid()) @db.Uuid
  key         String          @unique
  resource    String
  action      String
  description String?
  scope       PermissionScope @default(BOTH)
  isSystem    Boolean         @default(false) @map("is_system")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@index([resource])
  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(uuid()) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  user       User  @relation("UserRoleTarget", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("UserRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model Organization {
  id           String             @id @default(uuid()) @db.Uuid
  name         String
  locality     String?
  contactEmail String?            @map("contact_email")
  slug         String             @unique
  status       OrganizationStatus @default(ACTIVE)
  createdById  String?            @map("created_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  createdBy   User?                    @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  activeUsers User[]                   @relation("UserActiveOrganization")
  members     OrganizationMember[]
  roles       Role[]
  invitations OrganizationInvitation[]
  auditLogs   AuditLog[]
  programmes  Programme[]
  households  Household[]

  enabledFeatures String[] @default([]) @map("enabled_features")

  @@index([status])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles        OrganizationMemberRole[]

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_members")
}

model OrganizationMemberRole {
  id           String   @id @default(uuid()) @db.Uuid
  memberId     String   @map("member_id") @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  assignedById String?  @map("assigned_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  member     OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User?              @relation("OrgMemberRoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([memberId, roleId])
  @@index([roleId])
  @@map("organization_member_roles")
}

model OrganizationInvitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  roleId         String           @map("role_id") @db.Uuid
  invitedById    String?          @map("invited_by_id") @db.Uuid
  recipientName  String?          @map("recipient_name")
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime         @map("expires_at")
  respondedAt    DateTime?        @map("responded_at")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)
  invitedBy    User?        @relation("OrganizationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([organizationId, email])
  @@index([email, status])
  @@index([expiresAt])
  @@map("organization_invitations")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  familyId         String    @map("family_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  deviceType       String?   @map("device_type")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  lastActivityAt   DateTime  @default(now()) @map("last_activity_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  revokedReason    String?   @map("revoked_reason")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHistory RefreshTokenHistory[]

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshTokenHistory {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @map("session_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  familyId  String   @map("family_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  usedAt    DateTime @default(now()) @map("used_at")
  expiresAt DateTime @map("expires_at")

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_token_history")
}

model EmailVerificationToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  organizationId String?  @map("organization_id") @db.Uuid
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  actor        User?         @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([organizationId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

enum ProgrammeStatus {
  draft
  published
  closed
}

model Programme {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  year                 Int
  closedAt             DateTime?       @map("closed_at") @db.Timestamptz(3)
  title                String
  status               ProgrammeStatus @default(draft)
  description          String?
  guidelines           String?
  faqs                 Json            @default("[]")
  publicEmail          String?         @map("public_email")
  registrationOpensAt  DateTime?       @map("registration_opens_at") @db.Timestamptz(3)
  registrationClosesAt DateTime?       @map("registration_closes_at") @db.Timestamptz(3)
  registrationLimit    Int?            @map("registration_limit")
  priceMinor           Int?            @map("price_minor")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  participationOptions ParticipationOption[]
  applicantHouseholds  ApplicantHousehold[]
  registrations        Registration[]

  animals Animal[]

  expenseCategories ExpenseCategory[]

  volunteers Volunteer[]
  schedules  Schedule[]

  beneficiaries      Beneficiary[]
  distributionPolicy DistributionPolicy?
  collectionWindows  CollectionWindow[]

  announcements          Announcement[]
  userNotifications      UserNotification[]
  notificationDispatches NotificationDispatch[]
  enquiries              ProgrammeEnquiry[]

  @@unique([id, organizationId])
  @@unique([organizationId, year])
  @@index([organizationId, id])
  @@map("programmes")
}

model Household {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  address        String
  contactEmail   String?  @map("contact_email")
  contactPhone   String?  @map("contact_phone")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  beneficiaries Beneficiary[]

  @@unique([organizationId, id])
  @@map("households")
}

enum RegistrationStatus {
  submitted
  approved
  rejected
  cancelled
}

model ParticipationOption {
  id          String  @id @default(uuid()) @db.Uuid
  programmeId String  @map("programme_id") @db.Uuid
  name        String
  priceMinor  Int     @map("price_minor")
  maxShares   Int     @map("max_shares")
  active      Boolean @default(true)

  programme     Programme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@unique([programmeId, id])
  @@map("participation_options")
}

model ApplicantHousehold {
  id           String  @id @default(uuid()) @db.Uuid
  programmeId  String  @map("programme_id") @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  name         String
  address      String
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  programme     Programme      @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  registrations Registration[]

  @@unique([programmeId, userId])
  @@unique([id, programmeId, userId])
  @@map("applicant_households")
}

model Registration {
  id                String             @id @default(uuid()) @db.Uuid
  programmeId       String             @map("programme_id") @db.Uuid
  applicantId       String             @map("applicant_id") @db.Uuid
  householdId       String             @map("household_id") @db.Uuid
  householdSnapshot Json               @map("household_snapshot")
  optionId          String             @map("option_id") @db.Uuid
  optionName        String             @map("option_name")
  unitPriceMinor    Int                @map("unit_price_minor")
  feeMinor          Int                @map("fee_minor")
  shares            Int
  status            RegistrationStatus @default(submitted)
  submittedAt       DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(3)
  decidedAt         DateTime?          @map("decided_at") @db.Timestamptz(3)
  decisionReason    String?            @map("decision_reason")

  programme Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  applicant User                @relation(fields: [applicantId], references: [id], onDelete: Restrict)
  household ApplicantHousehold  @relation(fields: [householdId, programmeId, applicantId], references: [id, programmeId, userId], onDelete: Restrict, onUpdate: Restrict)
  option    ParticipationOption @relation(fields: [programmeId, optionId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)

  shareAllocation ShareAllocation?
  payments        Payment[]
  receipts        Receipt[]

  distributionAllocations DistributionAllocation[]

  @@unique([programmeId, id])
  @@unique([programmeId, applicantId])
  @@index([programmeId, id])
  @@index([programmeId, status])
  @@map("registrations")
}

model Animal {
  id                   String    @id @default(uuid()) @db.Uuid
  programmeId          String    @map("programme_id") @db.Uuid
  reference            String
  shareCapacity        Int       @map("share_capacity")
  supplierName         String?   @map("supplier_name")
  procurementCostMinor Int?      @map("procurement_cost_minor")
  procuredAt           DateTime? @map("procured_at") @db.Timestamptz(3)

  programme Programme     @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  groups    AnimalGroup[]

  schedules Schedule[]

  @@unique([programmeId, id])
  @@unique([programmeId, reference])
  @@map("animals")
}

model AnimalGroup {
  id          String @id @default(uuid()) @db.Uuid
  programmeId String @map("programme_id") @db.Uuid
  animalId    String @map("animal_id") @db.Uuid
  name        String

  animal      Animal            @relation(fields: [programmeId, animalId], references: [programmeId, id], onDelete: Restrict)
  allocations ShareAllocation[]

  @@unique([programmeId, id, animalId])
  @@index([programmeId, id])
  @@map("animal_groups")
}

model ShareAllocation {
  id             String @id @default(uuid()) @db.Uuid
  programmeId    String @map("programme_id") @db.Uuid
  animalId       String @map("animal_id") @db.Uuid
  groupId        String @map("group_id") @db.Uuid
  registrationId String @unique @map("registration_id") @db.Uuid
  shares         Int

  group        AnimalGroup  @relation(fields: [programmeId, groupId, animalId], references: [programmeId, id, animalId], onDelete: Restrict, onUpdate: Restrict)
  registration Registration @relation(fields: [programmeId, registrationId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([programmeId, registrationId])
  @@index([programmeId, id])
  @@index([programmeId, animalId])
  @@index([programmeId, groupId])
  @@map("share_allocations")
}

enum PaymentStatus {
  pending
  verified
  rejected
}

enum PaymentMethod {
  cash
  upi
  bank_transfer
  other
}

enum ReceiptKind {
  registration
  payment
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  programmeId    String        @map("programme_id") @db.Uuid
  registrationId String        @map("registration_id") @db.Uuid
  requestKey     String        @map("request_key")
  amountMinor    Int           @map("amount_minor")
  method         PaymentMethod
  reference      String?
  receivedAt     DateTime      @map("received_at") @db.Timestamptz(3)
  status         PaymentStatus @default(pending)
  decidedAt      DateTime?     @map("decided_at") @db.Timestamptz(3)
  decisionReason String?       @map("decision_reason")

  cashAssignmentId  String? @map("cash_assignment_id") @db.Uuid
  cashSubmittedById String? @map("cash_submitted_by_id") @db.Uuid

  cashAssignment VolunteerTask? @relation(fields: [programmeId, cashAssignmentId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  registration   Registration   @relation(fields: [programmeId, registrationId], references: [programmeId, id], onDelete: Restrict)
  receipt        Receipt?

  @@unique([programmeId, requestKey])
  @@unique([programmeId, registrationId, id])
  @@index([programmeId, id])
  @@index([programmeId, registrationId, status])
  @@index([cashAssignmentId])
  @@map("payments")
}

model Receipt {
  id             String      @id @default(uuid()) @db.Uuid
  programmeId    String      @map("programme_id") @db.Uuid
  registrationId String      @map("registration_id") @db.Uuid
  paymentId      String?     @unique @map("payment_id") @db.Uuid
  kind           ReceiptKind
  amountMinor    Int?        @map("amount_minor")
  issuedAt       DateTime    @default(now()) @map("issued_at") @db.Timestamptz(3)

  registration Registration @relation(fields: [programmeId, registrationId], references: [programmeId, id], onDelete: Restrict)
  payment      Payment?     @relation(fields: [programmeId, registrationId, paymentId], references: [programmeId, registrationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([programmeId, registrationId, paymentId])
  @@index([programmeId, registrationId, id])
  @@map("receipts")
}

model ExpenseCategory {
  id          String @id @default(uuid()) @db.Uuid
  programmeId String @map("programme_id") @db.Uuid
  name        String
  nameKey     String @map("name_key")

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  expenses  Expense[]

  @@unique([programmeId, id])
  @@unique([programmeId, nameKey])
  @@map("expense_categories")
}

model Expense {
  id          String   @id @default(uuid()) @db.Uuid
  programmeId String   @map("programme_id") @db.Uuid
  categoryId  String   @map("category_id") @db.Uuid
  amountMinor Int      @map("amount_minor")
  description String
  incurredAt  DateTime @map("incurred_at") @db.Timestamptz(3)

  category ExpenseCategory @relation(fields: [programmeId, categoryId], references: [programmeId, id], onDelete: Restrict)

  @@index([programmeId, id])
  @@map("expenses")
}

enum Department {
  slaughter
  processing
  distribution
  finance
}

enum WorkState {
  pending
  in_progress
  completed
}

enum ProcessingStage {
  cutting
  weighing
  packaging
}

enum IssueState {
  open
  resolved
}

model Volunteer {
  id          String       @id @default(uuid()) @db.Uuid
  programmeId String       @map("programme_id") @db.Uuid
  name        String
  email       String
  userId      String?      @map("user_id") @db.Uuid
  departments Department[]
  active      Boolean      @default(true)

  programme Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  user      User?            @relation(fields: [userId], references: [id], onDelete: Restrict)
  teams     ScheduleMember[]
  tasks     VolunteerTask[]
  issues    OperationIssue[]

  @@unique([programmeId, id])
  @@unique([programmeId, email])
  @@unique([programmeId, userId])
  @@map("volunteers")
}

model Schedule {
  id            String           @id @default(uuid()) @db.Uuid
  programmeId   String           @map("programme_id") @db.Uuid
  department    Department
  animalId      String?          @map("animal_id") @db.Uuid
  startsAt      DateTime         @map("starts_at") @db.Timestamptz(3)
  endsAt        DateTime         @map("ends_at") @db.Timestamptz(3)
  location      String
  status        WorkState        @default(pending)
  stage         ProcessingStage?
  measuredGrams Int?             @map("measured_grams")
  packageCount  Int?             @map("package_count")
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  programme Programme        @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  animal    Animal?          @relation(fields: [programmeId, animalId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  team      ScheduleMember[]
  tasks     VolunteerTask[]
  issues    OperationIssue[]

  @@unique([programmeId, id])
  @@unique([programmeId, animalId, department])
  @@index([programmeId, department, status])
  @@map("programme_schedules")
}

model ScheduleMember {
  programmeId String @map("programme_id") @db.Uuid
  scheduleId  String @map("schedule_id") @db.Uuid
  volunteerId String @map("volunteer_id") @db.Uuid

  schedule  Schedule  @relation(fields: [programmeId, scheduleId], references: [programmeId, id], onDelete: Restrict)
  volunteer Volunteer @relation(fields: [programmeId, volunteerId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@id([programmeId, scheduleId, volunteerId])
  @@index([programmeId, volunteerId])
  @@map("schedule_members")
}

model VolunteerTask {
  id          String     @id @default(uuid()) @db.Uuid
  programmeId String     @map("programme_id") @db.Uuid
  department  Department
  assigneeId  String     @map("assignee_id") @db.Uuid
  title       String
  scheduleId  String?    @map("schedule_id") @db.Uuid
  resourceId  String?    @map("resource_id") @db.Uuid
  status      WorkState  @default(pending)
  note        String?
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignee Volunteer        @relation(fields: [programmeId, assigneeId], references: [programmeId, id], onDelete: Restrict)
  schedule Schedule?        @relation(fields: [programmeId, scheduleId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  issues   OperationIssue[]
  payments Payment[]

  @@unique([programmeId, id])
  @@index([programmeId, assigneeId, department])
  @@map("volunteer_tasks")
}

model OperationIssue {
  id          String      @id @default(uuid()) @db.Uuid
  programmeId String      @map("programme_id") @db.Uuid
  reporterId  String      @map("reporter_id") @db.Uuid
  department  Department?
  taskId      String?     @map("task_id") @db.Uuid
  operationId String?     @map("operation_id") @db.Uuid
  description String
  status      IssueState  @default(open)
  resolution  String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  reporter  Volunteer      @relation(fields: [programmeId, reporterId], references: [programmeId, id], onDelete: Restrict)
  task      VolunteerTask? @relation(fields: [programmeId, taskId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  operation Schedule?      @relation(fields: [programmeId, operationId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([programmeId, id])
  @@index([programmeId, reporterId])
  @@map("operation_issues")
}

enum EligibilityStatus {
  pending
  approved
  rejected
}

enum DistributionRecipient {
  participant
  beneficiary
}

enum DistributionStatus {
  draft
  confirmed
  packed
  collected
  delivered
  cancelled
}

model Beneficiary {
  id              String            @id @default(uuid()) @db.Uuid
  programmeId     String            @map("programme_id") @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  householdId     String            @map("household_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  eligibility     EligibilityStatus @default(pending)
  reason          String?
  accessEmail     String?           @map("access_email")
  accessTokenHash String?           @unique @map("access_token_hash")
  accessExpiresAt DateTime?         @map("access_expires_at") @db.Timestamptz(3)

  programme   Programme                @relation(fields: [programmeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  household   Household                @relation(fields: [organizationId, householdId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  user        User?                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  allocations DistributionAllocation[]

  @@unique([programmeId, id])
  @@unique([programmeId, userId])
  @@unique([programmeId, householdId])
  @@map("beneficiaries")
}

model DistributionPolicy {
  programmeId          String  @id @map("programme_id") @db.Uuid
  participantsEnabled  Boolean @map("participants_enabled")
  gramsPerShare        Int     @map("grams_per_share")
  beneficiariesEnabled Boolean @map("beneficiaries_enabled")
  gramsPerHousehold    Int     @map("grams_per_household")
  publicGuidance       String  @map("public_guidance")

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@map("distribution_policies")
}

model CollectionWindow {
  id           String   @id @default(uuid()) @db.Uuid
  programmeId  String   @map("programme_id") @db.Uuid
  location     String
  startsAt     DateTime @map("starts_at") @db.Timestamptz(3)
  endsAt       DateTime @map("ends_at") @db.Timestamptz(3)
  instructions String

  programme   Programme                @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  allocations DistributionAllocation[]

  @@unique([programmeId, id])
  @@map("collection_windows")
}

model DistributionAllocation {
  id                  String                @id @default(uuid()) @db.Uuid
  programmeId         String                @map("programme_id") @db.Uuid
  recipientType       DistributionRecipient @map("recipient_type")
  registrationId      String?               @map("registration_id") @db.Uuid
  beneficiaryId       String?               @map("beneficiary_id") @db.Uuid
  quantityGrams       Int                   @map("quantity_grams")
  collectionWindowId  String                @map("collection_window_id") @db.Uuid
  status              DistributionStatus    @default(draft)
  collectionReference String?               @unique @map("collection_reference") @db.Uuid
  packedAt            DateTime?             @map("packed_at") @db.Timestamptz(3)
  handedOffAt         DateTime?             @map("handed_off_at") @db.Timestamptz(3)

  registration     Registration?    @relation(fields: [programmeId, registrationId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  beneficiary      Beneficiary?     @relation(fields: [programmeId, beneficiaryId], references: [programmeId, id], onDelete: Restrict, onUpdate: Restrict)
  collectionWindow CollectionWindow @relation(fields: [programmeId, collectionWindowId], references: [programmeId, id], onDelete: Restrict)

  @@index([programmeId, id])
  @@index([programmeId, status])
  @@index([programmeId, collectionWindowId])
  @@index([programmeId, registrationId])
  @@index([programmeId, beneficiaryId])
  @@map("distribution_allocations")
}

enum NotificationAudience {
  participants
  beneficiaries
  volunteers
  all
}

enum NotificationEmailState {
  queued
  sending
  sent
  failed
  skipped
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @map("programme_id") @db.Uuid
  title       String
  body        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@index([programmeId, id])
  @@map("programme_announcements")
}

model UserNotification {
  id          String    @id @default(uuid()) @db.Uuid
  programmeId String    @map("programme_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  body        String
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime? @map("read_at") @db.Timestamptz(3)

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([programmeId, userId, id])
  @@map("programme_notifications")
}

model NotificationDispatch {
  id          String               @id @default(uuid()) @db.Uuid
  programmeId String               @map("programme_id") @db.Uuid
  title       String
  body        String
  audience    NotificationAudience
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  programme Programme           @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  emails    NotificationEmail[]

  @@index([programmeId, id])
  @@map("notification_dispatches")
}

model NotificationEmail {
  id         String                 @id @default(uuid()) @db.Uuid
  dispatchId String                 @map("dispatch_id") @db.Uuid
  userId     String                 @map("user_id") @db.Uuid
  state      NotificationEmailState @default(queued)
  attempts   Int                    @default(0)
  readyAt    DateTime               @default(now()) @map("ready_at") @db.Timestamptz(3)
  claim      String?                @db.Uuid

  dispatch NotificationDispatch @relation(fields: [dispatchId], references: [id], onDelete: Restrict)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, userId])
  @@index([state, readyAt])
  @@map("notification_email_jobs")
}

model ProgrammeEnquiry {
  id          String   @id @default(uuid()) @db.Uuid
  programmeId String   @map("programme_id") @db.Uuid
  name        String
  replyEmail  String   @map("reply_email")
  message     String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  programme Programme @relation(fields: [programmeId], references: [id], onDelete: Restrict)

  @@index([programmeId, id])
  @@map("programme_enquiries")
}

model EmailChangeToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  email        String
  tokenVersion Int       @map("token_version")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@map("email_change_tokens")
}
